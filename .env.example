# Keys are read from environment variables only. Copy to .env (loaded automatically) or export them.

# AWS Bedrock — debate models (Claude, Llama, Mistral) and judges (Nova Pro, Command R+).
# Either an IAM access key pair...
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # only for temporary credentials
# ...or a Bedrock API key:
# AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# OpenAI — optional third judge (GPT-4o). Skipped if unset.
OPENAI_API_KEY=

# Optional: alternative config file
# CONFIG_PATH=config/config.yaml
